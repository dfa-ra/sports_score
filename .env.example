# Скопируйте в .env и подставьте свои значения. Секреты в git не коммитить.
DATABASE_NAME=studentleague
DATABASE_URL=jdbc:postgresql://postgres:5432/studentleague
DATABASE_USERNAME=studentleague
DATABASE_PASSWORD=studentleague
REDIS_URL=redis://redis:6379
APP_REDIS_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
# Единственный админ (создаётся при старте backend)
ADMIN_EMAIL=admin@studentleague.local
ADMIN_PASSWORD=ChangeMeAdmin123!
# Аватары и логотипы на диске сервера
LOCAL_STORAGE_DIR=./data/uploads
LOCAL_STORAGE_PUBLIC_BASE_URL=/media
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
SERVER_PORT=8080
WEB_PORT=80
AUTH_RATE_LIMIT=30
SPRING_PROFILES_ACTIVE=dev
# Вход через Google. Пустой client id — кнопка скрыта, пароль работает.
# VITE_GOOGLE_CLIENT_ID нужен при сборке web (см. web/.env.example).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
APP_PUBLIC_URL=http://localhost:5173
# SMTP. Пустой MAIL_HOST — письмо сброса не уходит.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
