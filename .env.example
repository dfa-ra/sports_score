# Скопируйте в .env и подставьте свои значения. Секреты в git не коммитить.
DATABASE_URL=jdbc:postgresql://postgres:5432/studentleague
DATABASE_USERNAME=studentleague
DATABASE_PASSWORD=studentleague
REDIS_URL=redis://redis:6379
APP_REDIS_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
S3_ENABLED=true
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=studentleague
S3_PUBLIC_BASE_URL=http://localhost:9000/studentleague
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SERVER_PORT=8080
AUTH_RATE_LIMIT=30
SPRING_PROFILES_ACTIVE=dev
