# Dev stand. Copy to /opt/studentleague/.env on the DEV server (not in git).
# CI does not overwrite an existing .env — only creates it if DEV_STAND_ENV is set
# and the file is missing.

COMPOSE_PROJECT_NAME=studentleague-dev

DATABASE_NAME=studentleague
DATABASE_USERNAME=studentleague
DATABASE_PASSWORD=change-me-strong-db-password
DATABASE_URL=jdbc:postgresql://postgres:5432/studentleague
REDIS_URL=redis://redis:6379
APP_REDIS_ENABLED=false

JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

ADMIN_EMAIL=admin@studentleague.local
ADMIN_PASSWORD=ChangeMeAdmin123!

LOCAL_STORAGE_DIR=/app/data/uploads
LOCAL_STORAGE_PUBLIC_BASE_URL=/media

# Public URL of this stand (no trailing slash). Add both http and https if needed.
CORS_ORIGINS=http://YOUR_DEV_HOST

SERVER_PORT=8080
# Host port mapped to Caddy :80. Current IP stand uses 3000.
CADDY_HTTP_PORT=3000
CADDY_HTTPS_PORT=443
# HTTP-only until the stand has a DNS name. Then: CADDY_SITE=dev.example.com
CADDY_SITE=http://:80
CADDY_EMAIL=

AUTH_RATE_LIMIT=30
APP_DEMO_DATA=true
SPRING_PROFILES_ACTIVE=prod
TZ=Europe/Moscow

JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC
