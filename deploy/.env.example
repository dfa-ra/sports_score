# Скопируйте в /opt/studentleague/.env на сервере (не в git).
# CI этот файл сам не перезаписывает — только создаёт, если задан секрет DEV_STAND_ENV
# и .env ещё нет.

DATABASE_NAME=studentleague
DATABASE_USERNAME=studentleague
DATABASE_PASSWORD=change-me-strong-db-password
DATABASE_URL=jdbc:postgresql://postgres:5432/studentleague
REDIS_URL=redis://redis:6379
APP_REDIS_ENABLED=false

JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

ADMIN_EMAIL=admin@studentleague.local
ADMIN_PASSWORD=ChangeMeAdmin123!

LOCAL_STORAGE_DIR=/app/data/uploads
LOCAL_STORAGE_PUBLIC_BASE_URL=/media

# Публичный URL стенда (без слэша в конце) + http/https варианты, если оба нужны
CORS_ORIGINS=http://YOUR_STAND_HOST

# Внутри Docker backend всегда слушает 8080 (nginx проксирует на backend:8080).
# Публичный порт на хосте — только WEB_PORT.
SERVER_PORT=8080
WEB_PORT=80
AUTH_RATE_LIMIT=30
SPRING_PROFILES_ACTIVE=prod
TZ=Europe/Moscow
