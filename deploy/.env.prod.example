# Production. Copy to /opt/studentleague/.env on the PROD server (not in git).
# Use a different JWT_SECRET and DATABASE_PASSWORD than on dev.
# CI writes this file only once if secret PROD_STAND_ENV is set and .env is missing.

COMPOSE_PROJECT_NAME=studentleague-prod

DATABASE_NAME=studentleague
DATABASE_USERNAME=studentleague
DATABASE_PASSWORD=change-me-strong-unique-prod-db-password
DATABASE_URL=jdbc:postgresql://postgres:5432/studentleague
REDIS_URL=redis://redis:6379
APP_REDIS_ENABLED=false

JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long!!
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

ADMIN_EMAIL=admin@itmoliga.ru
ADMIN_PASSWORD=change-me-strong-unique-admin-password

LOCAL_STORAGE_DIR=/app/data/uploads
LOCAL_STORAGE_PUBLIC_BASE_URL=/media

CORS_ORIGINS=https://itmoliga.ru,https://www.itmoliga.ru

SERVER_PORT=8080
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_FILE=Caddyfile.prod
CADDY_SITE=itmoliga.ru, www.itmoliga.ru
CADDY_EMAIL=admin@itmoliga.ru

AUTH_RATE_LIMIT=30
APP_DEMO_DATA=false
SPRING_PROFILES_ACTIVE=prod
TZ=Europe/Moscow

JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC
